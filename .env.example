# ---- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Public key id only, safe for the client bundle (used by Razorpay Checkout.js)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# From Razorpay Dashboard → Webhooks, when you register /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=your-resend-key
EMAIL_FROM="hotbid <hello@yourdomain.in>"

# ---- App ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional: Upstash Redis (rate limiting / caching) ------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional: PostHog (product analytics) -------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---- Optional: Sentry (error tracking) -----------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
